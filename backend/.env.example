# Port & Environment
PORT=5000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=smart_parking_db

# Fallback & Embedded Options
USE_EMBEDDED_DB=false

# UPI Payment Demo Settings
UPI_VPA=smartparking@icici
UPI_PAYEE_NAME=Smart Parking System
