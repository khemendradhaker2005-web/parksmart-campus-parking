# Port & Environment
PORT=5001
NODE_ENV=development

# JWT Secret
JWT_SECRET=smart_parking_super_secret_jwt_key_2026_secure

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smart_parking_db

# Fallback & Embedded Options
# Set to 'true' to force embedded database without attempting PostgreSQL connection
USE_EMBEDDED_DB=false

# UPI Payment Demo Settings
UPI_VPA=smartparking@icici
UPI_PAYEE_NAME=Smart Parking System
